# EXEMPLO COMPLETO: backend + referência do frontend.
# Copie para .env no CPABackend e substitua os placeholders de segredo.
# Para o CPAFrontend, use o .env.example daquele repositório (somente variáveis públicas).
# Este arquivo não altera os .env existentes nem configura um realm já criado.

# Infraestrutura local: portas externas da imagem enviada.
# O nome cpa-femass mantém compatibilidade com o healthcheck atual do Compose.
POSTGRES_DB=cpa-femass
POSTGRES_USER=postgres
POSTGRES_PORT=5435
BACKEND_PORT=8081
FRONTEND_PORT=5175
QUARKUS_DATASOURCE_PASSWORD_VARIABLE=SUBSTITUA_POR_UMA_SENHA_DO_BANCO

# Banco dentro do Docker: use o serviço postgres e a porta interna 5432.
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/cpa-femass
QUARKUS_DATASOURCE_USERNAME=postgres

# CORS e autenticação administrativa.
# FRONTEND_PORT é a porta do Nginx no Compose, não a do Vite (5173).
QUARKUS_HTTP_CORS_ORIGINS_VARIABLE=http://localhost:5175
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_DO_CONSOLE
KEYCLOAK_CPA_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_DO_USUARIO_CPA
KEYCLOAK_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_FRONTEND_URL=http://localhost:5175
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/realms/cpa
KEYCLOAK_CLIENT_ID=cpa-backend

# Validação de participação, PIN e autorização (durações ISO-8601).
VALIDACAO_CODIGO_EXPIRACAO=PT336H
# Identificação do aluno: segredo de pelo menos 32 bytes. Vazio bloqueia envios de alunos.
# Configure uma vez e preserve-o: trocar a seed impede reconhecer participações anteriores.
VALIDACAO_ALUNO_HASH_SEED=bf18b43b61652b5d73f41ebf3d72e5e43aebf5076f497dde31ea3de9de4998ef
VERIFICACAO_EMAIL_PIN_EXPIRACAO=PT2H
VERIFICACAO_EMAIL_AUTORIZACAO_EXPIRACAO=PT15M
VERIFICACAO_EMAIL_DIGEST_SECRET=not-configured
# Substitua not-configured acima por um segredo longo e aleatório para habilitar email.

# Chave mestra para professor/funcionário. Vazia desabilita essa alternativa.
# Para habilitar, preencha com um segredo longo e aleatório (até 1024 caracteres).
# Apenas no backend: nunca use prefixo VITE_ nem copie a chave para o frontend.
VERIFICACAO_EMAIL_CHAVE_MESTRA=

# Gmail API: habilite somente após preencher OAuth, remetente e segredo de digest.
VERIFICACAO_EMAIL_GMAIL_ENABLED=false
VERIFICACAO_EMAIL_GMAIL_CLIENT_ID=not-configured
VERIFICACAO_EMAIL_GMAIL_CLIENT_SECRET=not-configured
VERIFICACAO_EMAIL_GMAIL_REFRESH_TOKEN=not-configured
VERIFICACAO_EMAIL_GMAIL_FROM=not-configured
VERIFICACAO_EMAIL_GMAIL_CONNECT_TIMEOUT=PT10S
VERIFICACAO_EMAIL_GMAIL_REQUEST_TIMEOUT=PT15S
# Remetente usado na imagem: cpafemasssystem@gmail.com.
# Preencha com a conta autorizada pelo seu refresh token; não reutilize credenciais no exemplo.

# Referência do FRONTEND: copie apenas estas variáveis públicas e FRONTEND_PORT
# para o .env do CPAFrontend. O Compose do backend não as encaminha ao frontend.
VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cpa
VITE_KEYCLOAK_CLIENT_ID=cpa-frontend
VITE_CPA_CAMPAIGN_UNAVAILABLE_MESSAGE="A pesquisa está indisponível no momento. Tente novamente mais tarde."
# Opcional: exporte no terminal para os testes, pois Playwright não lê o .env do Vite.
PLAYWRIGHT_CHANNEL=msedge

# AMBIENTE DE TESTE DA IMAGEM: substitua os valores locais acima por estes
# quando usar os respectivos domínios e configure os proxies/realm de acordo.
# QUARKUS_HTTP_CORS_ORIGINS_VARIABLE=https://teste.cpafemass.com.br
# KEYCLOAK_PUBLIC_URL=https://teste.auth.cpafemass.com.br
# KEYCLOAK_FRONTEND_URL=https://teste.cpafemass.com.br
# KEYCLOAK_AUTH_SERVER_URL=https://teste.auth.cpafemass.com.br/realms/cpa
# VITE_API_BASE_URL=https://teste.bc.cpafemass.com.br
# VITE_KEYCLOAK_URL=https://teste.auth.cpafemass.com.br
# POSTGRES_DB=cpa-femass-teste
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/cpa-femass-teste
# Se mudar POSTGRES_DB, ajuste também o healthcheck fixo do PostgreSQL no Compose.
# Alterar estas variáveis não renomeia um banco nem atualiza um realm existente.

# BACKEND EXECUTADO FORA DO DOCKER: exemplos alternativos, não cumulativos.
# Exporte as variáveis no ambiente do processo Java. Os aliases _VARIABLE são do Compose.
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5435/cpa-femass
# QUARKUS_DATASOURCE_USERNAME=postgres
# QUARKUS_DATASOURCE_PASSWORD=SUBSTITUA_PELA_MESMA_SENHA_DO_BANCO
# QUARKUS_HTTP_CORS_ORIGINS=http://localhost:5173
# KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180/realms/cpa
# O backend Java local escuta em 8080 por padrão; BACKEND_PORT só publica a porta no Compose.
# Para o Vite local, ajuste também KEYCLOAK_FRONTEND_URL=http://localhost:5173
# e VITE_API_BASE_URL=http://localhost:8080 no frontend.

# Alternativa nativa OIDC vista na imagem. Prevalece se passada ao processo Java.
# O Compose atual não encaminha esta chave: prefira KEYCLOAK_AUTH_SERVER_URL.
# QUARKUS_OIDC_AUTH_SERVER_URL=https://teste.auth.cpafemass.com.br/realms/cpa

# Variáveis recebidas/definidas pelos containers: o Compose já faz estes mapeamentos.
# Declará-las apenas no .env não substitui os aliases usados pelo Compose.
# POSTGRES_PASSWORD=SUBSTITUA_PELA_MESMA_SENHA_DO_BANCO
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_DO_CONSOLE
# KC_HOSTNAME=http://localhost:8180
# KC_HEALTH_ENABLED=true
# KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true

# Variáveis antigas da imagem, mantidas somente como referência (sem efeito atualmente).
# KEYCLOAK_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_SE_CONFIGURAR_BANCO_EXTERNO
# Keycloak atual usa start-dev sem banco externo; esta chave não é consumida.
# VITE_CPA_CAMPAIGN=cpa-2026
# A pesquisa seleciona a campanha automaticamente pelo período; esta chave não é consumida.

# IMAGENS JAVA ALTERNATIVAS: somente para src/main/docker/Dockerfile.jvm ou legacy-jar.
# Não são encaminhadas pelo Compose atual nem usadas pelo Dockerfile da raiz.
# Passe explicitamente ao container somente se usar essas imagens alternativas.
# JAVA_OPTS=
# JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
# JAVA_APP_JAR=/deployments/quarkus-run.jar
# LANGUAGE=en_US:en
# JAVA_MAX_MEM_RATIO=50
# JAVA_INITIAL_MEM_RATIO=25
# JAVA_MAX_INITIAL_MEM=4096
# JAVA_DIAGNOSTICS=false
# JAVA_DEBUG=false
# JAVA_DEBUG_PORT=5005
# CONTAINER_CORE_LIMIT=
# CONTAINER_MAX_MEMORY=
# GC_MIN_HEAP_FREE_RATIO=
# GC_MAX_HEAP_FREE_RATIO=
# GC_TIME_RATIO=
# GC_ADAPTIVE_SIZE_POLICY_WEIGHT=
# GC_METASPACE_SIZE=
# GC_MAX_METASPACE_SIZE=
# GC_CONTAINER_OPTIONS=
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
