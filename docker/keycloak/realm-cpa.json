{
  "realm": "cpa",
  "enabled": true,
  "displayName": "CPA FeMASS",
  "roles": {
    "realm": [
      { "name": "cpa-admin", "description": "Administra campanhas e versões da CPA" }
    ]
  },
  "clients": [
    {
      "clientId": "cpa-backend",
      "name": "CPA Backend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": true
    },
    {
      "clientId": "cpa-frontend",
      "name": "CPA Frontend administrativo",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KEYCLOAK_FRONTEND_URL}/admin", "${KEYCLOAK_FRONTEND_URL}/admin/*"],
      "webOrigins": ["${KEYCLOAK_FRONTEND_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KEYCLOAK_FRONTEND_URL}/"
      },
      "protocolMappers": [{
        "name": "cpa-backend-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": { "included.client.audience": "cpa-backend", "id.token.claim": "false", "access.token.claim": "true" }
      }]
    },
    {
      "clientId": "cpa-dev-cli",
      "name": "Cliente de desenvolvimento CPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [{
        "name": "cpa-backend-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": { "included.client.audience": "cpa-backend", "id.token.claim": "false", "access.token.claim": "true" }
      }]
    }
  ],
  "users": [
    {
      "username": "cpa-admin",
      "email": "cpa-admin@local.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "CPA",
      "lastName": "Administrator",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_CPA_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": [ "cpa-admin" ]
    }
  ]
}
